{
  "name": "vxpods",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live": "node scripts/run-live-provider-tests.js",
    "test:live:client": "VXPODS_LIVE_PROVIDER=1 vitest run tests/live/provider-client.live.test.js",
    "test:live:browser": "VXPODS_LIVE_PROVIDER=1 playwright test e2e/live-provider.spec.js --project=chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.8.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7"
  }
}
